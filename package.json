{
  "name": "emissornf",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_OPTIONS=\"--use-system-ca --openssl-legacy-provider\" nest start",
    "start:dev": "cross-env NODE_OPTIONS=\"--use-system-ca --openssl-legacy-provider\" nest start --watch",
    "start:debug": "cross-env NODE_OPTIONS=\"--use-system-ca --openssl-legacy-provider\" nest start --debug --watch",
    "start:prod": "cross-env NODE_OPTIONS=\"--use-system-ca --openssl-legacy-provider\" node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:cov:open": "jest --coverage && node scripts/abrir-arquivo.js coverage/lcov-report/index.html",
    "test:report:open": "jest && node scripts/abrir-arquivo.js test-report/unit/index.html",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration": "node scripts/rodar-testes-integracao.js",
    "test:integration:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:integration:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:integration:report:open": "node scripts/abrir-arquivo.js test-report/integration/index.html",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/typeorm.datasource.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fast-xml-parser": "^5.10.1",
    "node-forge": "^1.4.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "jest-html-reporters": "^3.1.7",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "reporters": [
      "default",
      [
        "jest-html-reporters",
        {
          "publicPath": "test-report/unit",
          "filename": "index.html",
          "pageTitle": "EmissorNF — Testes unitários",
          "expand": true,
          "coverageLink": "../../coverage/lcov-report/index.html"
        }
      ]
    ]
  }
}
