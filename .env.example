# Aplicação
PORT=3000

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=emissornf
DB_SYNCHRONIZE=false

# Ambiente SEFAZ: 1 = Produção, 2 = Homologação
SEFAZ_AMBIENTE=2
SEFAZ_UF=SP

# Certificado digital A1 (.pfx) do CNPJ do MEI
CERTIFICADO_PATH=./certs/certificado.pfx
CERTIFICADO_SENHA=troque-esta-senha

# Dados do emitente (MEI)
EMITENTE_CNPJ=00000000000000
EMITENTE_RAZAO_SOCIAL="NOME DO MEI"
EMITENTE_NOME_FANTASIA="NOME FANTASIA"
# EMITENTE_IE=ISENTO é o valor especial reconhecido pelo builder para omitir a tag <IE> do XML
EMITENTE_IE=ISENTO
# CRT 4 = Simples Nacional - MEI (código específico desde 01/04/2025, Ajuste SINIEF 43/2023)
EMITENTE_CRT=4
EMITENTE_LOGRADOURO="Rua Exemplo"
EMITENTE_NUMERO=100
EMITENTE_COMPLEMENTO=
EMITENTE_BAIRRO="Centro"
EMITENTE_MUNICIPIO="Sao Paulo"
EMITENTE_COD_MUNICIPIO=3550308
EMITENTE_UF=SP
EMITENTE_CEP=00000000
EMITENTE_TELEFONE=

# Numeração dos documentos fiscais
NFE_SERIE=1
NFCE_SERIE=1

# CSC (Código de Segurança do Contribuinte) e CSC ID, usados para montar o QR Code da
# NFC-e (grupo infNFeSupl). Vêm de um credenciamento específico para NFC-e no portal da
# SEFAZ-SP (https://www.nfce.fazenda.sp.gov.br/) — distinto do certificado digital, e
# homologação/produção têm CSC próprios. Sem isso, a emissão de NFC-e falha com erro
# explícito ao montar o XML.
NFCE_CSC=
NFCE_CSC_ID=
