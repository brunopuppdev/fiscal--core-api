# Aplicação
PORT=3000

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=emissornf
DB_SYNCHRONIZE=true

# Ambiente SEFAZ: 1 = Produção, 2 = Homologação
SEFAZ_AMBIENTE=2
SEFAZ_UF=SP

# Certificado digital A1 (.pfx) do CNPJ do MEI
CERTIFICADO_PATH=./certs/certificado.pfx
CERTIFICADO_SENHA=troque-esta-senha

# Dados do emitente (MEI)
EMITENTE_CNPJ=00000000000000
EMITENTE_RAZAO_SOCIAL="NOME DO MEI"
EMITENTE_NOME_FANTASIA="NOME FANTASIA"
EMITENTE_IE=ISENTO
EMITENTE_CRT=1
EMITENTE_LOGRADOURO="Rua Exemplo"
EMITENTE_NUMERO=100
EMITENTE_COMPLEMENTO=
EMITENTE_BAIRRO="Centro"
EMITENTE_MUNICIPIO="Sao Paulo"
EMITENTE_COD_MUNICIPIO=3550308
EMITENTE_UF=SP
EMITENTE_CEP=00000000
EMITENTE_TELEFONE=

# Numeração dos documentos fiscais
NFE_SERIE=1
NFCE_SERIE=1
